# ============================================
# Tenant Selection
# ============================================
# Which assistant this process serves:
#   chikku -> Chikku Robotics support   (chikku_db / chikku_kb) [default]
#   saigon -> Saigon Indian Restaurant  (chroma_db / hotel_saigon_menu)
# Each tenant supplies its own vector store, system prompt, intents and
# validator rules. See src/tenant_config.py.
TENANT=chikku

# Optional per-field overrides (leave commented to use the tenant defaults):
# CHROMA_DIR=chikku_db
# COLLECTION_NAME=chikku_kb
# SYSTEM_PROMPT_FILE=data/chikku_system_prompt.txt

# ============================================
# SaigonBot Multi-Tenant Chatbot Configuration
# ============================================
# Copy this file to .env and modify as needed:
#   Windows (PowerShell): Copy-Item config.env .env
#   Linux/macOS (bash):   cp config.env .env

# ============================================
# RAG Pipeline Settings
# ============================================
# Number of items to retrieve from vector database
TOP_K=7

# Number of items after reranking (used when USE_RERANKING=true)
RERANK_K=12

# ============================================
# LLM Provider Switch
# ============================================
# Choose provider: openai | ollama
LLM_PROVIDER=openai

# ============================================
# OpenAI Models (used when LLM_PROVIDER=openai)
# ============================================
# Your OpenAI API key (required when LLM_PROVIDER=openai)
OPENAI_API_KEY=

# OpenAI chat model (gpt-4o-mini is fast & cheap; gpt-4o for best quality)
OPENAI_LLM_MODEL=gpt-4o-mini
# Note: embeddings always use Ollama (EMBEDDING_MODEL below) — no OpenAI embedding key needed

# ============================================
# Ollama Models (embeddings always use Ollama; generation uses LLM_MODEL if LLM_PROVIDER=ollama)
# ============================================
# Embedding model for vector search (always required: ollama pull mxbai-embed-large)
EMBEDDING_MODEL=mxbai-embed-large

# Local LLM model for response generation (only used when LLM_PROVIDER=ollama)
# Make sure to pull: ollama pull llama3:8b-instruct-q4_0
# Lighter/alternative options: llama3.2, deepseek-r1:latest
LLM_MODEL=llama3:8b-instruct-q4_0

# Force Ollama to run on CPU (set to true to avoid CUDA out-of-memory errors)
FORCE_CPU=false

# ============================================
# Reranking & Query Processing
# ============================================
# Enable cross-encoder reranking via FlagEmbedding (downloads ~1-2 GB model on first run)
# Set to true for higher ranking precision; keep false for fast setup and low memory usage
USE_RERANKING=false

# Normalize speech-to-text food terms in the restaurant (saigon) pipeline
QUERY_NORMALIZATION=true

# ============================================
# Multilingual Settings
# ============================================
# The vector index, intent patterns and chunk metadata are all English. A
# non-English question is therefore translated to English for retrieval, and the
# LLM is instructed to write its answer back in the caller's language — one
# index serves every language. See src/language.py.
#
# Set to false to disable translation entirely (English-only behaviour, no extra
# LLM round-trip per non-English turn).
MULTILINGUAL_ENABLED=true

# Language reported by GET /stats as the configured default.
# Supported: en, hi, ta, bn, gu, ml, kn, te, pa, vi
DEFAULT_LANGUAGE=en

# Translated queries and canned strings are cached, so a repeated question costs
# no extra LLM call. Raise on a busy kiosk with a narrow set of questions.
TRANSLATION_CACHE_MAX_SIZE=300

# Proper nouns that must keep their exact spelling when a question is translated
# for retrieval. A Tamil-script question carries no Latin spelling, so the
# translator transliterates by ear ("சிக்கு ரோபோட்டிக்ஸ்" -> "Siku Robotics") and
# the result then has to match the index. Pipe-separated.
TRANSLATION_GLOSSARY=Chikku Robotics|S-Robot|WatchGuard6S|Surender Rangaraju

# ============================================
# API Server Settings
# ============================================
# Host and port for the API server (used by run_api.py and src/api.py)
API_HOST=0.0.0.0
API_PORT=8000

# ============================================
# Caching Settings
# ============================================
# Enable retrieval cache (speeds up repeated queries)
RAG_CACHE_ENABLED=true
RAG_CACHE_MAX_SIZE=100

# Enable embedding cache (speeds up embedding generation)
EMBEDDING_CACHE_ENABLED=true
EMBEDDING_CACHE_MAX_SIZE=200

# ============================================
# Response Quality & Validation
# ============================================
# Enable response quality validation (removes AI disclaimers)
ENABLE_RESPONSE_VALIDATION=true

# ============================================
# Rate Limiting (Production)
# ============================================
# Enable rate limiting to prevent abuse
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=60

# ============================================
# CORS Settings (Production)
# ============================================
# Comma-separated list of allowed origins
# Use "*" for development, specific domains for production
ALLOWED_ORIGINS=*

# ============================================
# Logging
# ============================================
LOG_LEVEL=INFO
USE_JSON_LOGS=false

# ============================================
# Test Client Settings (used by test_api.py and simple_test.py)
# ============================================
# HTTP request timeout in seconds for test scripts
API_TIMEOUT=60
